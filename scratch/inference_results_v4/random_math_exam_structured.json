    },
    {
      "label": "question_label",
      "start": 1838,
      "end": 1844,
      "text": "Câu 8."
    },
    {
      "label": "stem",
      "start": 1844,
      "end": 1957,
      "text": " Đường tròn $C$ có tâm $I$ thuộc đường thẳng $d: x+5y-12 = 0$ và tiếp xúc với hai trục tọa độ có phương trình là:"
    },
    {
      "label": "option_label",
      "start": 1958,
      "end": 1960,
      "text": "A."
    },
    {
      "label": "option_text",
      "start": 1961,
      "end": 1984,
      "text": "$(x-2)^2 + (y-2)^2 = 4$"
    },
    {
      "label": "option_label",
      "start": 1986,
      "end": 1988,
      "text": "B."
    },
    {
      "label": "option_text",
      "start": 1989,
      "end": 2013,
      "text": "$(x+3)^2 + (y-3)^2 = 9$."
